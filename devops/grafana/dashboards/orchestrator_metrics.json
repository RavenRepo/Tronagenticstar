{
  "uid": "orch-metrics",
  "title": "Orchestrator Metrics",
  "schemaVersion": 38,
  "version": 1,
  "panels": [
    {
      "type": "graph",
      "title": "Task Count (completed)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "agent_messages_processed_total",
          "legendFormat": "{{agent_id}}",
          "refId": "A"
        }
      ],
      "id": 1
    },
    {
      "type": "graph",
      "title": "ErrorGold Events",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "errorgold_events_total",
          "legendFormat": "events",
          "refId": "B"
        }
      ],
      "id": 2
    }
  ]
} 