{
  "name": "@agentforge/eslint-plugin",
  "version": "0.1.0",
  "description": "ESLint plugin for AgentForge development patterns and best practices",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "agentforge",
    "agents",
    "linting",
    "code-quality"
  ],
  "author": "AgentForge Team",
  "license": "MIT",
  "peerDependencies": {
    "eslint": ">=8.0.0"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^6.7.4"
  },
  "devDependencies": {
    "@types/eslint": "^8.44.6",
    "@types/node": "^20.8.7",
    "eslint": "^8.51.0",
    "typescript": "^5.2.2",
    "vitest": "^0.34.6",
    "prettier": "^3.0.3"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=16.0.0"
  }
}
