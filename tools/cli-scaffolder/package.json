{
  "name": "@agentforge/cli",
  "version": "0.1.0",
  "description": "CLI scaffolder for AgentForge projects and agents",
  "main": "dist/index.js",
  "bin": {
    "agentforge": "dist/cli.js",
    "af": "dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "agentforge",
    "cli",
    "scaffolder",
    "agents",
    "development",
    "tools"
  ],
  "author": "AgentForge Team",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.1.0",
    "chalk": "^5.3.0",
    "inquirer": "^9.2.12",
    "fs-extra": "^11.1.1",
    "handlebars": "^4.7.8",
    "ora": "^7.0.1",
    "figlet": "^1.7.0",
    "semver": "^7.5.4",
    "glob": "^10.3.10"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.3",
    "@types/inquirer": "^9.0.6",
    "@types/figlet": "^1.5.6",
    "@types/semver": "^7.5.4",
    "typescript": "^5.2.2",
    "tsx": "^3.14.0",
    "vitest": "^0.34.6",
    "eslint": "^8.51.0",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "prettier": "^3.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
