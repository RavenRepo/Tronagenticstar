{
  "name": "tronagenticstar",
  "displayName": "Tronagenticstar - AI Agent Orchestration",
  "description": "Orchestrate AI agents for comprehensive software development with skills, MCP tools, and advanced agent types",
  "version": "0.2.0",
  "publisher": "tronagenticstar",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ai",
    "agents",
    "orchestration",
    "development",
    "automation",
    "skills",
    "mcp"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tronagenticstar.showActivity",
        "title": "Show Agent Activity",
        "category": "Tronagenticstar",
        "icon": "$(pulse)"
      },
      {
        "command": "tronagenticstar.openChat",
        "title": "Chat with Agents",
        "category": "Tronagenticstar",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "tronagenticstar.showDashboard",
        "title": "Project Dashboard",
        "category": "Tronagenticstar",
        "icon": "$(dashboard)"
      },
      {
        "command": "tronagenticstar.showSettings",
        "title": "Settings",
        "category": "Tronagenticstar",
        "icon": "$(settings-gear)"
      },
      {
        "command": "tronagenticstar.triggerArchitectureAnalysis",
        "title": "Analyze Architecture",
        "category": "Tronagenticstar",
        "icon": "$(graph)"
      },
      {
        "command": "tronagenticstar.triggerSecurityScan",
        "title": "Security Scan",
        "category": "Tronagenticstar",
        "icon": "$(shield)"
      },
      {
        "command": "tronagenticstar.triggerQualityCheck",
        "title": "Quality Check",
        "category": "Tronagenticstar",
        "icon": "$(verified)"
      },
      {
        "command": "tronagenticstar.generateAgent",
        "title": "Generate New Agent",
        "category": "Tronagenticstar",
        "icon": "$(add)"
      },
      {
        "command": "tronagenticstar.refreshActivity",
        "title": "Refresh",
        "category": "Tronagenticstar",
        "icon": "$(refresh)"
      },
      {
        "command": "tronagenticstar.executeTool",
        "title": "Execute Tool",
        "category": "Tronagenticstar | Tools",
        "icon": "$(tools)"
      },
      {
        "command": "tronagenticstar.listTools",
        "title": "List Available Tools",
        "category": "Tronagenticstar | Tools",
        "icon": "$(list)"
      },
      {
        "command": "tronagenticstar.forkAgent",
        "title": "Fork Subagent",
        "category": "Tronagenticstar | Agents",
        "icon": "$(git-branch)"
      },
      {
        "command": "tronagenticstar.exploreFiles",
        "title": "Explore Files",
        "category": "Tronagenticstar | Agents",
        "icon": "$(files)"
      },
      {
        "command": "tronagenticstar.verifyChanges",
        "title": "Verify Changes",
        "category": "Tronagenticstar | Agents",
        "icon": "$(check)"
      },
      {
        "command": "tronagenticstar.listSkills",
        "title": "List Skills",
        "category": "Tronagenticstar | Skills",
        "icon": "$(package)"
      },
      {
        "command": "tronagenticstar.executeSkill",
        "title": "Execute Skill",
        "category": "Tronagenticstar | Skills",
        "icon": "$(play)"
      },
      {
        "command": "tronagenticstar.connectMCP",
        "title": "Connect MCP Server",
        "category": "Tronagenticstar | MCP",
        "icon": "$(plug)"
      },
      {
        "command": "tronagenticstar.listMCPTools",
        "title": "List MCP Tools",
        "category": "Tronagenticstar | MCP",
        "icon": "$(list-flat)"
      }
    ],
    "views": {
      "tronagenticstar": [
        {
          "id": "tronagenticstar.activity",
          "name": "Agent Activity",
          "when": "tronagenticstar.enabled",
          "icon": "$(pulse)"
        },
        {
          "id": "tronagenticstar.agents",
          "name": "Available Agents",
          "when": "tronagenticstar.enabled",
          "icon": "$(robot)"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tronagenticstar",
          "title": "Tronagenticstar",
          "icon": "$(robot)"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "tronagenticstar.refreshActivity",
          "when": "view == tronagenticstar.activity",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "tronagenticstar.showActivity",
          "when": "tronagenticstar.enabled"
        },
        {
          "command": "tronagenticstar.openChat",
          "when": "tronagenticstar.enabled"
        },
        {
          "command": "tronagenticstar.showDashboard",
          "when": "tronagenticstar.enabled"
        },
        {
          "command": "tronagenticstar.triggerArchitectureAnalysis",
          "when": "tronagenticstar.enabled"
        },
        {
          "command": "tronagenticstar.triggerSecurityScan",
          "when": "tronagenticstar.enabled"
        },
        {
          "command": "tronagenticstar.triggerQualityCheck",
          "when": "tronagenticstar.enabled"
        },
        {
          "command": "tronagenticstar.executeTool",
          "when": "tronagenticstar.enabled"
        },
        {
          "command": "tronagenticstar.listTools",
          "when": "tronagenticstar.enabled"
        },
        {
          "command": "tronagenticstar.forkAgent",
          "when": "tronagenticstar.enabled"
        },
        {
          "command": "tronagenticstar.exploreFiles",
          "when": "tronagenticstar.enabled"
        },
        {
          "command": "tronagenticstar.verifyChanges",
          "when": "tronagenticstar.enabled"
        },
        {
          "command": "tronagenticstar.listSkills",
          "when": "tronagenticstar.enabled"
        },
        {
          "command": "tronagenticstar.executeSkill",
          "when": "tronagenticstar.enabled"
        },
        {
          "command": "tronagenticstar.connectMCP",
          "when": "tronagenticstar.enabled"
        },
        {
          "command": "tronagenticstar.listMCPTools",
          "when": "tronagenticstar.enabled"
        }
      ]
    },
    "configuration": {
      "title": "Tronagenticstar",
      "properties": {
        "tronagenticstar.gatewayUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "URL of the Tronagenticstar API Gateway"
        },
        "tronagenticstar.apiKey": {
          "type": "string",
          "description": "API key for gateway authentication (or JWT token)"
        },
        "tronagenticstar.authType": {
          "type": "string",
          "enum": [
            "apikey",
            "jwt"
          ],
          "default": "apikey",
          "description": "Authentication type for API Gateway"
        },
        "tronagenticstar.enableRealTimeUpdates": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time updates via WebSocket"
        },
        "tronagenticstar.rateLimitWarning": {
          "type": "boolean",
          "default": true,
          "description": "Show warnings when approaching rate limits"
        },
        "tronagenticstar.autoRetry": {
          "type": "boolean",
          "default": true,
          "description": "Automatically retry failed requests with exponential backoff"
        },
        "tronagenticstar.requestTimeout": {
          "type": "number",
          "default": 30000,
          "description": "Request timeout in milliseconds"
        },
        "tronagenticstar.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info",
          "description": "Logging level for Tronagenticstar extension"
        },
        "tronagenticstar.enableServiceProxy": {
          "type": "boolean",
          "default": false,
          "description": "Enable direct service proxy features (advanced)"
        },
        "tronagenticstar.enableTeamMemory": {
          "type": "boolean",
          "default": true,
          "description": "Enable team memory for shared context between agents"
        },
        "tronagenticstar.enableHooks": {
          "type": "boolean",
          "default": true,
          "description": "Enable hook system for custom event handling"
        },
        "tronagenticstar.defaultAgentType": {
          "type": "string",
          "enum": [
            "generalPurpose",
            "explore",
            "plan",
            "verification"
          ],
          "default": "generalPurpose",
          "description": "Default agent type for new agents"
        },
        "tronagenticstar.mcpServers": {
          "type": "array",
          "default": [],
          "description": "MCP server configurations"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "18.x",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0",
    "eslint": "^8.47.0",
    "typescript": "^5.1.6",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4",
    "ts-loader": "^9.4.4",
    "@vscode/test-electron": "^2.3.4",
    "@vscode/vsce": "^2.19.0"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "socket.io-client": "^4.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/tronagenticstar.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/tronagenticstar/issues"
  },
  "homepage": "https://github.com/your-org/tronagenticstar#readme"
}
