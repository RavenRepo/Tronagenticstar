# Constella API Gateway Environment Configuration
# Copy this file to .env and configure for your environment

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server settings
API_GATEWAY_PORT=3000
API_GATEWAY_HOST=0.0.0.0
NODE_ENV=development

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h
BCRYPT_ROUNDS=12

# API Keys (JSON format) - For development only
# In production, use a secure key management system
API_KEYS={"dev-key-12345":{"id":"dev-key-1","name":"Development Key","permissions":["*"],"rateLimit":1000,"dailyLimit":10000,"active":true}}

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:*,https://localhost:*,http://127.0.0.1:*
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_HEADERS=Origin,X-Requested-With,Content-Type,Accept,Authorization,X-API-Key,X-Request-ID

# =============================================================================
# RATE LIMITING
# =============================================================================

# Rate limit configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL=false
RATE_LIMIT_SKIP_FAILED=false

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis settings (for rate limiting and caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# SERVICE DISCOVERY
# =============================================================================

# Health check configuration
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# Default request timeouts
DEFAULT_REQUEST_TIMEOUT=30000
MAX_REQUEST_TIMEOUT=120000

# =============================================================================
# MICROSERVICES CONFIGURATION
# =============================================================================

# Orchestrator Service
ORCHESTRATOR_URL=http://localhost:3001
ORCHESTRATOR_TIMEOUT=30000
ORCHESTRATOR_RETRY_ATTEMPTS=3

# Embedding Service
EMBEDDING_URL=http://localhost:8001
EMBEDDING_TIMEOUT=20000
EMBEDDING_RETRY_ATTEMPTS=2

# Retriever Service
RETRIEVER_URL=http://localhost:8002
RETRIEVER_TIMEOUT=15000
RETRIEVER_RETRY_ATTEMPTS=2

# DesignForge Service
DESIGNFORGE_URL=http://localhost:8003
DESIGNFORGE_TIMEOUT=25000
DESIGNFORGE_RETRY_ATTEMPTS=2

# SecuriShield Service
SECURISHIELD_URL=http://localhost:8004
SECURISHIELD_TIMEOUT=20000
SECURISHIELD_RETRY_ATTEMPTS=2

# CodeCraft Service
CODECRAFT_URL=http://localhost:8005
CODECRAFT_TIMEOUT=30000
CODECRAFT_RETRY_ATTEMPTS=3

# PerfPulse Service
PERFPULSE_URL=http://localhost:8006
PERFPULSE_TIMEOUT=15000
PERFPULSE_RETRY_ATTEMPTS=2

# SOC2 Compliance Service
SOC2_COMPLIANCE_URL=http://localhost:8007
SOC2_COMPLIANCE_TIMEOUT=20000
SOC2_COMPLIANCE_RETRY_ATTEMPTS=2

# =============================================================================
# ADDITIONAL SERVICES
# =============================================================================

# Additional services (comma-separated service names)
ADDITIONAL_SERVICES=

# Example for additional service:
# ADDITIONAL_SERVICES=myservice,anotherservice
# MYSERVICE_URL=http://localhost:9001
# MYSERVICE_HEALTH_PATH=/health
# MYSERVICE_WEIGHT=5
# MYSERVICE_TIMEOUT=15000
# MYSERVICE_RETRY_ATTEMPTS=2

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================

# Monitoring endpoints
METRICS_PATH=/metrics
HEALTH_PATH=/health
ENABLE_PROMETHEUS=true

# Logging configuration
LOG_LEVEL=debug
LOG_FORMAT=combined

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================

# These should be set in production environments:

# Production JWT Secret (generate a strong random key)
# JWT_SECRET=your-production-jwt-secret-256-bits-long

# Production CORS Origins (specific domains only)
# CORS_ORIGINS=https://app.constella.com,https://api.constella.com

# Production Redis (managed Redis service)
# REDIS_HOST=your-redis-cluster.cache.amazonaws.com
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password

# Production API Keys (use secure key management)
# API_KEYS should not be set via environment in production
# Use AWS Secrets Manager, HashiCorp Vault, or similar

# Production Rate Limits (more restrictive)
# RATE_LIMIT_MAX_REQUESTS=60
# RATE_LIMIT_WINDOW_MS=60000

# Production Service URLs (internal service mesh or ELB)
# ORCHESTRATOR_URL=http://orchestrator.constella.internal:3001
# EMBEDDING_URL=http://embedding.constella.internal:8001
# etc...

# =============================================================================
# DEVELOPMENT/DEBUG SETTINGS
# =============================================================================

# Development-specific settings (only used when NODE_ENV=development)

# Enable development endpoints
ENABLE_DEV_ENDPOINTS=true

# Enable detailed error responses
ENABLE_DEBUG_ERRORS=true

# Enable request/response logging
ENABLE_REQUEST_LOGGING=true

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================

# When running in Docker, use these service names instead of localhost:

# ORCHESTRATOR_URL=http://orchestrator:3001
# EMBEDDING_URL=http://embedding:8001
# RETRIEVER_URL=http://retriever:8002
# DESIGNFORGE_URL=http://designforge:8003
# SECURISHIELD_URL=http://securishield:8004
# CODECRAFT_URL=http://codecraft:8005
# PERFPULSE_URL=http://perfpulse:8006
# SOC2_COMPLIANCE_URL=http://soc2-compliance:8007
# REDIS_HOST=redis

# =============================================================================
# KUBERNETES CONFIGURATION
# =============================================================================

# When running in Kubernetes, use service DNS names:

# ORCHESTRATOR_URL=http://orchestrator-service.constella.svc.cluster.local:3001
# EMBEDDING_URL=http://embedding-service.constella.svc.cluster.local:8001
# etc...
# REDIS_HOST=redis-service.constella.svc.cluster.local
