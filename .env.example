# =============================================================================
# Constella/AgentForge Environment Variables - EXAMPLE
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to source control!
# =============================================================================

# REQUIRED
OPENAI_API_KEY=your-openai-api-key-here
JWT_SECRET=generate-a-strong-random-secret-min-32-chars

# PRODUCTION SECRETS
REDIS_PASSWORD=generate-strong-password-here
NEO4J_PASSWORD=generate-strong-password-here
GRAFANA_ADMIN_PASSWORD=generate-strong-password-here
GRAFANA_SECRET_KEY=generate-strong-random-key-here

# OPTIONAL - LLM Providers
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
OLLAMA_URL=http://localhost:11434

# OPTIONAL - AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Application Settings
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=1000
MAX_REQUEST_SIZE_MB=10
METRICS_AUTH_REQUIRED=true

# Service Authentication
AGENT_BEARER_TOKEN=generate-strong-bearer-token-here
PYTHON_EXPERT_TOKEN=generate-strong-token-here
MEMORY_GUARDIAN_TOKEN=generate-strong-token-here
GRAFANA_ADMIN_USER=admin
