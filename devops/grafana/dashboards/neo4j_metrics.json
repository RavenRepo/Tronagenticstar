{
  "uid": "neo4j-metrics",
  "title": "Neo4j Metrics",
  "schemaVersion": 30,
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Queries Per Second (5m)",
      "gridPos": {"h":4,"w":6,"x":0,"y":0},
      "datasource": "Prometheus",
      "targets": [
        {"expr": "rate(neo4j_db_query_seconds_count[5m])", "legendFormat": "qps"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Query Latency p95",
      "gridPos": {"h":8,"w":12,"x":6,"y":0},
      "datasource": "Prometheus",
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(neo4j_db_query_seconds_bucket[5m])) by (le))", "legendFormat": "p95 latency"}
      ]
    }
  ]
} 