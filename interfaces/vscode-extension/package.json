{
  "name": "constella-architect",
  "displayName": "Constella AI Architect",
  "description": "Enterprise AI Operating Platform - Intelligent multi-agent development workflows",
  "version": "1.0.0",
  "publisher": "constella",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "Extension Packs"
  ],
  "keywords": [
    "ai",
    "artificial intelligence",
    "agent",
    "multi-agent",
    "enterprise",
    "workflow",
    "automation",
    "architecture"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "constella.orchestrateTask",
        "title": "Orchestrate Task",
        "category": "Constella"
      },
      {
        "command": "constella.viewWorkflows",
        "title": "View Active Workflows",
        "category": "Constella"
      },
      {
        "command": "constella.configureProject",
        "title": "Configure Project Context",
        "category": "Constella"
      },
      {
        "command": "constella.showAgentStatus",
        "title": "Show Agent Status",
        "category": "Constella"
      },
      {
        "command": "constella.generateFeature",
        "title": "Generate Feature",
        "category": "Constella"
      },
      {
        "command": "constella.fixBug",
        "title": "AI Bug Fix",
        "category": "Constella"
      },
      {
        "command": "constella.securityAudit",
        "title": "Security Audit",
        "category": "Constella"
      },
      {
        "command": "constella.optimizePerformance",
        "title": "Optimize Performance",
        "category": "Constella"
      },
      {
        "command": "constella.codeReview",
        "title": "AI Code Review",
        "category": "Constella"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "constella.orchestrateTask",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "constella.viewWorkflows",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "constella.configureProject",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "constella.showAgentStatus"
        },
        {
          "command": "constella.generateFeature",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "constella.fixBug",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "constella.securityAudit",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "constella.optimizePerformance",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "constella.codeReview",
          "when": "workspaceFolderCount > 0"
        }
      ],
      "editor/context": [
        {
          "command": "constella.codeReview",
          "when": "editorTextFocus",
          "group": "constella@1"
        },
        {
          "command": "constella.fixBug",
          "when": "editorTextFocus",
          "group": "constella@2"
        },
        {
          "command": "constella.optimizePerformance",
          "when": "editorTextFocus",
          "group": "constella@3"
        }
      ],
      "explorer/context": [
        {
          "command": "constella.generateFeature",
          "when": "explorerResourceIsFolder",
          "group": "constella@1"
        },
        {
          "command": "constella.securityAudit",
          "when": "explorerResourceIsFolder",
          "group": "constella@2"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "constellaWorkflows",
          "name": "Constella Workflows",
          "when": "workspaceFolderCount > 0"
        },
        {
          "id": "constellaAgents",
          "name": "AI Agents",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "constella",
          "title": "Constella AI",
          "icon": "$(robot)"
        }
      ]
    },
    "configuration": {
      "title": "Constella",
      "properties": {
        "constella.orchestratorUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "URL of the Constella Orchestrator service"
        },
        "constella.apiToken": {
          "type": "string",
          "default": "",
          "description": "API token for Constella services (optional)"
        },
        "constella.projectId": {
          "type": "string",
          "default": "",
          "description": "Project ID for context persistence"
        },
        "constella.autoExecuteWorkflows": {
          "type": "boolean",
          "default": false,
          "description": "Automatically execute workflows after creation"
        },
        "constella.notificationLevel": {
          "type": "string",
          "enum": ["all", "errors", "none"],
          "default": "all",
          "description": "Level of notifications to show"
        },
        "constella.defaultTechStack": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["JavaScript", "TypeScript", "Node.js", "React"],
          "description": "Default technology stack for new projects"
        },
        "constella.qualityGates": {
          "type": "object",
          "properties": {
            "coverage": {
              "type": "number",
              "default": 80
            },
            "codeQuality": {
              "type": "string",
              "default": "A"
            },
            "securityScan": {
              "type": "boolean",
              "default": true
            },
            "performanceCheck": {
              "type": "boolean",
              "default": true
            }
          },
          "default": {
            "coverage": 80,
            "codeQuality": "A",
            "securityScan": true,
            "performanceCheck": true
          },
          "description": "Quality gates for automated workflows"
        }
      }
    },
    "keybindings": [
      {
        "command": "constella.orchestrateTask",
        "key": "ctrl+shift+c o",
        "mac": "cmd+shift+c o",
        "when": "editorTextFocus"
      },
      {
        "command": "constella.generateFeature",
        "key": "ctrl+shift+c f",
        "mac": "cmd+shift+c f",
        "when": "editorTextFocus"
      },
      {
        "command": "constella.fixBug",
        "key": "ctrl+shift+c b",
        "mac": "cmd+shift+c b",
        "when": "editorTextFocus"
      },
      {
        "command": "constella.codeReview",
        "key": "ctrl+shift+c r",
        "mac": "cmd+shift+c r",
        "when": "editorTextFocus"
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.28.0",
    "typescript": "^4.9.4",
    "@vscode/test-electron": "^2.2.0",
    "@vscode/vsce": "^2.15.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "ws": "^8.14.0",
    "@types/ws": "^8.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/constella.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/constella/issues"
  },
  "homepage": "https://github.com/your-org/constella#readme",
  "license": "MIT"
}
